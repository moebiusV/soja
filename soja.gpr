--  soja: a drop-in replacement for the soju IRC bouncer, written in Ada.
--
--  Core library project, following the convention of the other
--  ada-on-alpine packages (imsg-ada, libsodium-ada): a static library built
--  by the ada-on-alpine aport.  The executable entry points (soja, sojactl,
--  sojudb) are separate main projects that import this library, mirroring
--  soju's cmd/ split.

with "aws.gpr";
with "cryptolib.gpr";
with "gnatcoll_sqlite.gpr";

library project Soja is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
   for Library_Name use "soja";

   --  Scenario variable, so gprinstall emits the installed "library_type :=
   --  static" marker that tells consuming projects this is a static library
   --  (without it gprbuild defaults to relocatable and forces -lgnat-15).
   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SOJA_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnato",
         "-gnaty3abcefhiklmnprt");
      --  bracke-cryptolib's RSA and random specifications have characters
      --  that are not ASCII in their comments: read this unit as UTF-8.
      for Switches ("soja-certgen.adb") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnato", "-gnatW8",
         "-gnaty3abcefhiklmnprt");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Active use "True";
   end Install;

end Soja;
