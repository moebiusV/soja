; ident-query.hbnf -- an RFC 1413 query line: "<port> , <port>" (identd.go
; parseIdentQuery).  White space may surround either number and the comma.
;
; hbnf's lexer cannot tell two uses of one token class apart, so the grammar
; only tokenises (white space, numbers, commas) and the walker
; (soja-identd.adb) checks that they come as: number comma number.
;
; Deviation from Go: only ASCII digits make a number (strconv.Atoi also takes
; a leading sign; "+80" is the one spelling that differs).

language Ada

include "common.hbnf"

query = *( ws | num | comma )

ws    = 1*WSP
num   = 1*DIGIT
comma = ","
