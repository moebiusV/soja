; ident-query.hbnf -- an RFC 1413 query line: "<port> , <port>" (identd.go
; parseIdentQuery).  White space may surround either number and the comma.
;
; The whole line is the grammar; the generated parser returns the two numbers
; (Query_Type.Local and .Remote) and refuses anything else, with the position.
; The range of a port (1 .. 65535) is checked by the caller (soja-identd.adb).
;
; Deviation from Go: strconv.Atoi also takes a leading '+' ("+80"); `int`
; does not.

prefix none
whitespace none
include "common.hbnf"

query  = *WSP local *WSP "," *WSP remote *WSP
local  = int
remote = int
