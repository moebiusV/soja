; http-head.hbnf -- one line of the head of an HTTP/1.x request, without its
; line end: the request line or a header field.
;
;     GET /socket?x=1 HTTP/1.1
;     Connection: keep-alive, Upgrade
;
; A field name is a token and the colon follows it at once (a space before it
; is refused, as net/http does); the value is the rest of the line, its leading
; blanks skipped, its trailing ones left for the caller (soja-http.adb) to
; trim.  (The `&token-char` looks at the name's first character and consumes
; nothing; it is there so that a field is a record in the tree: a rule of text
; rules only is read as one text, and the caller could not tell the name from
; the value.)  Bytes are read as UTF-8 text: a value in another encoding is refused,
; where net/http keeps its bytes.
;
; Cutting the head into lines (CR LF, or LF alone as net/http takes it) and
; finding its end, the empty line, is the reader's work, not the grammar's.

prefix none
whitespace none
include "common.hbnf"

head-line    = request-line | field
request-line = method SP target SP version
method       = 1*token-char
target       = 1*VCHAR
version      = "HTTP/" major "." minor
major        = int
minor        = int
field        = &token-char field-name colon *WSP field-value
field-name   = 1*token-char
field-value  = *~( CR | LF )

; The colon, with the blank that usually follows it.
colon        = ": " | ":"

token-char   = ALPHA | DIGIT | "!" | "#" | "$" | "%" | "&" | "'" | "*" | "+"
             | "-" | "." | "^" | "_" | "`" | "|" | "~"
