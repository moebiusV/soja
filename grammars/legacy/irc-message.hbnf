; irc-message.hbnf — the IRC wire message, RFC 2812 §2.3.1 + IRCv3
; message-tags, matching gopkg.in/irc.v4's parser.  Jet-free.
;
; A message is a sequence of space-delimited words.  A word is a single
; lexer token; its FIRST character picks the character class, which keeps the
; classes disjoint so the maximal-munch scanner emits one token per word:
;
;     atword    — starts with '@'   (the IRCv3 message-tags region)
;     colonword — starts with ':'   (the prefix, or a trailing param's start)
;     plainword — starts with either (command, middle param)
;
; The grammar captures the structure; the walker (soja-irc-hbnf.adb) applies
; irc.v4's semantics: it strips the '@'/':' markers, splits tags on ';'/'='
; and the prefix on '!'/'@', upper-cases the command, and re-assembles the
; trailing param (which may itself contain spaces, colons and '@').

language Ada

include "common.hbnf"

message = [ atword gap ] [ colonword gap ] plainword *( gap plainword )
          [ trailing ]

; The trailing param: a " :"-prefixed word, then the rest of the words.  The
; leading spaces are the " :" marker; the remaining words keep their own
; separators so the walker can re-assemble the trailing byte-for-byte.
trailing = gap colonword *( gap atword | gap colonword | gap plainword )

; A word starting with '@' (message tags), with its '@' kept.
atword    = "@" *VCHAR
; A word starting with ':' (prefix, or the start of a trailing param).
colonword = ":" *VCHAR
; A word starting with neither '@' nor ':' (command, middle param).
plainword = plain *VCHAR

; VCHAR (0x21-0x7E) minus ':' (0x3A) and '@' (0x40).
plain = %x21-39 / %x3B-3F / %x41-7E

; A run of one or more spaces (0x20).  Captured as a scalar string so the
; walker can count the spaces (needed to re-assemble a trailing param exactly).
; Named `gap` rather than `spaces`: the generated parser uses `Spaces` for its
; own error-message padding.
gap = 1*%x20
