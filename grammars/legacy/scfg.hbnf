; scfg.hbnf — soja's config grammar.  soju's config file (config/config.go)
; is parsed by go-scfg, whose model is LINE-BASED: one directive per line,
; `#` comments, blank lines skipped.  In this revision the file is flat — no
; nested blocks.  We reuse the obconf lexer core (word/str/int) and express
; the line structure explicitly, because hbnf's Ada backend has no
; `whitespace ws` auto-skip (that machinery is C-only).
;
; Divergences from obconf / go-scfg, to review:
;   * bareword set — obconf's base is ALPHA|DIGIT|_|-|.; we widen it with
;     `:` `/` `+` `=` `?` `%` `*` `@` `$` so URIs (`ircs://`) and paths
;     (`/var/lib/soju/main.db`) lex as one word.  go-scfg's bareword is
;     "anything but space/tab/quote", wider still (it admits `#`, `{`, `}`).
;   * comments — the lexer skips `#` to end-of-line ANYWHERE; go-scfg treats
;     `#` as a comment only at the start of a line (elsewhere it is a bareword
;     char).  Identical for soju's real configs, where `#` is only ever a
;     whole-line comment.
;   * quotes — go-scfg accepts `'...'` as well as `"..."`; obconf (and soja)
;     accept only `"..."`.  soju never uses single quotes.
;   * escapes — go-scfg drops `\` before any char, in barewords and strings
;     alike; soja only inside `"..."`.  soju's barewords contain no `\`.
;   * adjacency — go-scfg rejects a quoted string abutting a bareword
;     (`foo"bar"`, `"foo"bar`); soja accepts it (the lexer emits two tokens).
;   * no blocks — soju's config is flat; obconf/go-scfg support `{...}`
;     blocks, but config.go declares none.
;
; Jet-free; the Ada backend only.

language Ada

include "obconf.hbnf"

; --- the root: a sequence of lines ------------------------------------------
; The lexer skips space/tab (they are not tokens here, unlike `gap` in the IRC
; grammar) and skips `#`-to-end-of-line, so a comment or blank line leaves
; only its newline token.  A standalone `nl` matches that residue; `directive`
; matches a real line (and consumes its own trailing `nl`).
config = *( nl | directive )

directive = word *( word | str ) nl

; --- the lexer, widened for soja's config tokens ---------------------------
; Every token is a string: override `int` so bare digits stay words (scfg has
; no integer type), then widen the bareword set for URIs and paths.
int  = word
word = 1*wordchars

wordchars = ALPHA | DIGIT | "_" | "-" | "." | ":" | "/" | "+" | "=" | "?" | "%" | "*" | "@" | "$"

; a newline (directive terminator): CRLF, LF, or CR
nl = CRLF | LF | CR
