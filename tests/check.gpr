--  Test project: builds and runs the soja checks.  Mirrors imsg-ada's
--  tests/check.gpr.  Add each *_check.adb here as more modules land.
with "../soja.gpr";

project Check is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";
   for Main use ("irc_check.adb");
end Check;
